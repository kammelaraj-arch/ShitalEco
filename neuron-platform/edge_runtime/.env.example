# Edge Runtime configuration. Defaults assume a single-site Linux edge host
# (e.g. a Raspberry Pi 5 running Docker) on a private factory LAN.

EDGE_DB_URL=sqlite+aiosqlite:///./data/edge.db
EDGE_POLICY_PATH=./policies/edge_default.json
EDGE_BIND_HOST=0.0.0.0
EDGE_BIND_PORT=8090

# Identity of this edge instance — must match the master's edge_systems entry.
EDGE_ID=edge-default
EDGE_SITE_ID=site-default
EDGE_PARENT_NODE_URL=https://neuron.shital.org.uk

# mTLS — paths to PEM files mounted into the container.
EDGE_TLS_ENABLED=false
EDGE_TLS_CERT_PATH=./certs/edge.crt
EDGE_TLS_KEY_PATH=./certs/edge.key
EDGE_TLS_CA_PATH=./certs/parent_ca.crt

EDGE_LOG_LEVEL=info
