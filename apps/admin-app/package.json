{
  "name": "shital-admin-app",
  "private": true,
  "version": "1.0.0",
  "description": "Thin Capacitor Android wrapper that live-loads the Shital Admin panel (admin.shital.org.uk).",
  "scripts": {
    "build:web": "node -e \"process.exit(require('fs').existsSync('dist/index.html')?0:1)\"",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android --inline"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
